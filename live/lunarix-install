#!/bin/sh
set -eu
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
export LC_ALL=C

media=/run/live
setup=$media/install-config
tools=/lib/install-tools

fail() {
    echo "lunarix-install: $*" >&2
    exit 1
}

tool() {
    program=$1
    shift
    "$tools/ld-linux-x86-64.so.2" --library-path "$tools" "$tools/$program" "$@"
}

disk_available() {
    name=$1
    block="/sys/class/block/$name"
    case "$name" in
        sd*|vd*|nvme*|mmcblk*) ;;
        *) return 1 ;;
    esac
    [ -b "/dev/$name" ] && [ ! -e "$block/partition" ] || return 1
    [ "$(cat "$block/ro")" = 0 ] && [ "$(cat "$block/size")" -ge 1048576 ] || return 1
    for member in "$block" "$block"/*; do
        [ -f "$member/dev" ] || continue
        [ "$member" = "$block" ] || [ -f "$member/partition" ] || continue
        [ "/dev/${member##*/}" != "$live_device" ] || return 1
        for holder in "$member"/holders/*; do
            [ ! -e "$holder" ] || return 1
        done
        major_minor=$(cat "$member/dev")
        if awk -v dev="$major_minor" '$3 == dev { found = 1 } END { exit !found }' /proc/self/mountinfo ||
            awk -v dev="/dev/${member##*/}" '$1 == dev { found = 1 } END { exit !found }' /proc/swaps; then
            return 1
        fi
    done
}

[ "$(id -u)" = 0 ] || fail "run as root in Lunarix Live"
[ -t 0 ] || fail "run the installer from an interactive terminal"
[ -d /sys/firmware/efi ] || fail "boot the live image in UEFI mode"
[ -s /run/live-device ] || fail "live media is unavailable"
read -r live_device < /run/live-device
[ -s "$media/installed-root.tar.gz" ] && [ -d "$media/system" ] &&
    [ -s "$media/packages/pkgr-update.pkgr.tar.gz" ] || fail "live media is missing system packages"
mountpoint -q /usr/lib/lunarix/network || fail "live media network tools are unavailable"
[ -s "$setup/locales" ] && [ -s "$setup/keymaps/us.bmap" ] &&
    [ -s "$setup/zoneinfo/UTC" ] || fail "live media is missing system setup data"

# A second installer must not race the target checks and partition writes.
lock=/run/lunarix-install.lock
mkdir "$lock" || fail "an installer is already running"
target=
tty_settings=
keymap=us
cleanup() {
    if [ -n "$tty_settings" ]; then stty "$tty_settings" || :; fi
    case "$(tty)" in
        /dev/tty[0-9]*)
            if [ "$keymap" != us ]; then loadkmap < "$setup/keymaps/us.bmap" || :; fi
            ;;
    esac
    if [ -n "$target" ]; then
        if mountpoint -q "$target/boot/efi"; then umount "$target/boot/efi" || return; fi
        if mountpoint -q "$target"; then umount "$target" || return; fi
        rmdir "$target" || :
    fi
    rmdir "$lock" || :
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

disk=
hostname=lunarix
language=C.UTF-8
timezone=UTC
username=

device_mib() {
    printf '%s MiB' "$(( $(cat "/sys/class/block/$1/size") / 2048 ))"
}

show_partitions() {
    for block_path in "/sys/class/block/$1"/*; do
        [ -f "$block_path/partition" ] || continue
        partition=${block_path##*/}
        filesystem=$(blkid "/dev/$partition" 2>/dev/null | sed -n 's/.* TYPE="\([a-zA-Z0-9_-]*\)".*/\1/p')
        printf '      /dev/%s  %s  %s\n' "$partition" "$(device_mib "$partition")" "${filesystem:-unknown}"
    done
}

choose_disk() {
    disks=
    number=0
    printf '\nChoose a whole disk to erase and install on\n'
    for block_path in /sys/class/block/*; do
        candidate=${block_path##*/}
        if disk_available "$candidate"; then
            number=$((number + 1))
            disks="${disks}/dev/$candidate
"
            model=
            if [ -r "$block_path/device/model" ]; then
                model=$(sed 's/[^ -~]//g' < "$block_path/device/model")
            fi
            printf '  %s) /dev/%s  %s  %s\n' "$number" "$candidate" "$(device_mib "$candidate")" "$model"
            show_partitions "$candidate"
        fi
    done
    if [ "$number" = 0 ]; then
        echo 'No eligible whole disks. Boot media, mounted drives, and active swap are excluded.'
        return
    fi
    while :; do
        printf 'Disk number or path (Enter to go back): '
        read -r answer || exit 1
        case "$answer" in
            '') return ;;
            /dev/*) selected=$answer ;;
            *[!0-9]*) selected= ;;
            *) selected=$(printf '%s' "$disks" | awk -v index_number="$answer" 'NR == index_number') ;;
        esac
        case "$selected" in
            /dev/*)
                candidate=${selected#/dev/}
                case "$candidate" in */*|''|.|..) ;; *)
                    if disk_available "$candidate" && printf '%s' "$disks" | grep -Fxq -- "$selected"; then
                        disk=$selected
                        return
                    fi ;;
                esac
                ;;
        esac
        echo 'Select a disk from the list.'
    done
}

choose_hostname() {
    while :; do
        printf 'Hostname [%s]: ' "$hostname"
        read -r answer || exit 1
        [ -n "$answer" ] || return
        case "$answer" in
            -*|*-|*[!a-z0-9-]*) ;;
            *) if [ "${#answer}" -le 63 ]; then hostname=$answer; return; fi ;;
        esac
        echo 'Use up to 63 lowercase letters, digits, or hyphens, with no leading or trailing hyphen.'
    done
}

choose_keyboard() {
    echo 'Console keyboard layouts: us uk de es fr'
    while :; do
        printf 'Console keyboard layout [%s]: ' "$keymap"
        read -r answer || exit 1
        case "$answer" in
            '') return ;;
            us|uk|de|es|fr)
                case "$(tty)" in
                    /dev/tty[0-9]*)
                        loadkmap < "$setup/keymaps/$answer.bmap" || fail "could not load $answer on the live console"
                        ;;
                esac
                keymap=$answer
                return ;;
        esac
        echo 'Choose one of the listed layouts.'
    done
}

choose_locale() {
    printf 'Locales available: '
    xargs < "$setup/locales"
    while :; do
        printf 'Locale [%s]: ' "$language"
        read -r answer || exit 1
        [ -n "$answer" ] || return
        if grep -Fxq -e "$answer" "$setup/locales"; then language=$answer; return; fi
        echo 'Choose one of the listed locales.'
    done
}

choose_timezone() {
    while :; do
        printf 'Time zone [%s] (for example America/Chicago): ' "$timezone"
        read -r answer || exit 1
        [ -n "$answer" ] || return
        case "$answer" in
            .*|/*|*..*|*[!A-Za-z0-9_+./-]*) ;;
            *) if [ -f "$setup/zoneinfo/$answer" ] &&
                   [ "$(head -c 4 "$setup/zoneinfo/$answer")" = TZif ]; then timezone=$answer; return; fi ;;
        esac
        echo 'Enter a valid time zone from the IANA time zone database.'
    done
}

choose_username() {
    while :; do
        printf 'Login username [%s]: ' "${username:-not set}"
        read -r answer || exit 1
        [ -n "$answer" ] || return
        case "$answer" in
            root|[!a-z]*|*[!a-z0-9_-]*) ;;
            *) if [ "${#answer}" -le 32 ]; then username=$answer; return; fi ;;
        esac
        echo 'Use up to 32 lowercase letters, digits, hyphens, or underscores. Begin with a letter and choose a name other than root.'
    done
}

review_install() {
    if [ -z "$disk" ] || [ -z "$username" ]; then
        echo 'Choose a target disk and a login username first.'
        return 1
    fi
    printf '\nReview installation\n'
    printf '  Whole disk to erase   %s (%s)\n' "$disk" "$(device_mib "${disk#/dev/}")"
    show_partitions "${disk#/dev/}"
    printf '  Hostname               %s\n  Login user             %s\n' "$hostname" "$username"
    printf '  Keyboard               %s\n  Locale                 %s\n  Time zone              %s\n' "$keymap" "$language" "$timezone"
    printf '\nAll data on %s will be erased. Type ERASE %s to install, or press Enter to go back: ' "$disk" "$disk"
    read -r confirmation || exit 1
    if [ "$confirmation" != "ERASE $disk" ]; then
        echo 'Installation canceled. Returning to setup.'
        return 1
    fi
}

printf '\nLunarix installer\nThis version installs to a whole disk and erases its existing partitions.\n'
while :; do
    cat <<MENU

Installation settings
  1) Target disk       ${disk:-not set}
  2) Hostname          $hostname
  3) Console keyboard  $keymap
  4) Locale            $language
  5) Time zone         $timezone
  6) Login username    ${username:-not set}
  7) Review and install
  q) Quit
MENU
    printf 'Choose an option: '
    read -r option || exit 1
    case "$option" in
        1) choose_disk ;;
        2) choose_hostname ;;
        3) choose_keyboard ;;
        4) choose_locale ;;
        5) choose_timezone ;;
        6) choose_username ;;
        7) if review_install; then break; fi ;;
        q|Q) echo 'Installer closed.'; exit 0 ;;
        *) echo 'Choose a number from the menu or q to quit.' ;;
    esac
done
name=${disk#/dev/}
disk_available "$name" || fail "$disk is no longer available"
printf '\nPreparing %s\n' "$disk"

target=$(mktemp -d /mnt/lunarix.XXXXXX)
root_partuuid=$(cat /proc/sys/kernel/random/uuid)
root_uuid=$(cat /proc/sys/kernel/random/uuid)
tool sfdisk --wipe always --wipe-partitions always "$disk" <<PARTITIONS
label: gpt
size=128MiB, type=uefi
type=linux, uuid=$root_partuuid
PARTITIONS
case "$disk" in
    *[0-9]) partition_prefix="${disk}p" ;;
    *) partition_prefix=$disk ;;
esac
esp="${partition_prefix}1"
root="${partition_prefix}2"
for _ in 1 2 3 4 5; do
    if [ -b "$esp" ] && [ -b "$root" ]; then break; fi
    sleep 1
done
[ -b "$esp" ] && [ -b "$root" ] || fail "new partition devices did not appear"

mkfs.vfat -F 32 -n LUNARIX_EFI "$esp"
tool mkfs.ext4 -q -U "$root_uuid" -L lunarix "$root"
mount -t ext4 "$root" "$target"
printf '\nInstalling the base system\n'
tar -xzf "$media/installed-root.tar.gz" -C "$target"
pkgr --root "$target" --repo "$media/system" install "$media/packages/pkgr-update.pkgr.tar.gz"
for package in lunarix-busybox lunarix-base lunarix-ca-certificates lunarix-net lunarix-firmware lunarix-boot linux-lunarix sudo; do
    pkgr --root "$target" --repo "$media/system" install "$package"
done
for package in "$media/packages/"*.pkgr.tar.gz; do
    [ -f "$package" ] || continue
    install -m644 "$package" "$target/usr/share/pkgr/repo/"
done
mount -t vfat "$esp" "$target/boot/efi"
cat > "$target/etc/fstab" <<FSTAB
UUID=$root_uuid / ext4 defaults 0 1
FSTAB
printf '%s\n' "$hostname" > "$target/etc/hostname"
printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s\n' "$hostname" > "$target/etc/hosts"
printf 'LANG=%s\n' "$language" > "$target/etc/locale.conf"
if [ "$language" != C ]; then
    locale_dir="${language%.UTF-8}.utf8"
    mkdir -p "$target/usr/lib/locale"
    cp -r "$setup/locale/$locale_dir" "$target/usr/lib/locale/"
fi
install -m 0644 "$setup/zoneinfo/$timezone" "$target/etc/localtime"
printf '%s\n' "$timezone" > "$target/etc/timezone"
mkdir -p "$target/usr/share/keymaps"
install -m 0644 "$setup/keymaps/$keymap.bmap" "$target/usr/share/keymaps/$keymap.bmap"
printf 'KEYMAP=%s\n' "$keymap" > "$target/etc/vconsole.conf"

chroot "$target" /usr/sbin/adduser -D -s /bin/sh "$username"
if ! grep -q '^netadmin:' "$target/etc/group"; then
    chroot "$target" /usr/sbin/addgroup -S netadmin
fi
chroot "$target" /usr/sbin/addgroup "$username" netadmin
tty_settings=$(stty -g)
stty -echo
echo "Set the password for $username."
chroot "$target" /usr/bin/passwd -a sha512 "$username"
echo 'Set the root password for system maintenance.'
chroot "$target" /usr/bin/passwd -a sha512 root
stty "$tty_settings"
tty_settings=
for account in "$username" root; do
    awk -F: -v name="$account" '$1 == name && $2 ~ /^\$/ { found = 1 } END { exit !found }' "$target/etc/shadow" ||
        fail "a password was not saved for $account"
done

esp_uuid=$(blkid "$esp" | sed -n 's/.* UUID="\([^"]*\)".*/\1/p')
[ -n "$esp_uuid" ] || fail "could not read the EFI filesystem UUID"
mkdir -p "$target/etc/lunarix"
printf '%s %s\n' "$esp_uuid" "$root_partuuid" > "$target/etc/lunarix/boot.conf"
chroot "$target" /usr/sbin/lunarix-boot-update --mounted
sync
umount "$target/boot/efi"
umount "$target"
echo 'Lunarix is installed. Power off, remove the live media, and boot from the target disk.'
