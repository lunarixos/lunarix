#!/usr/bin/env bash
set -euo pipefail

work=$1
build=$2
dist="$build/distfiles"
prefix="$work/static"
mkdir -p "$dist" "$prefix"

extract() {
    local url=$1 checksum=$2 archive
    archive="$dist/${url##*/}"
    if [[ ! -s "$archive" ]]; then
        curl --fail --location --retry 3 --output "$work/download" "$url"
        printf '%s  %s\n' "$checksum" "$work/download" | sha256sum --check --status
        mv -- "$work/download" "$archive"
    fi
    printf '%s  %s\n' "$checksum" "$archive" | sha256sum --check --status || {
        echo "error: checksum mismatch for $archive" >&2
        exit 1
    }
    tar -xf "$archive" -C "$work"
}

extract https://zlib.net/fossils/zlib-1.4.tar.gz \
    02dd159783677a749c04adbdd02b55b8a2bcc7e054f51b76b549199a916ad584
extract https://github.com/libarchive/libarchive/releases/download/v3.8.11/libarchive-3.8.11.tar.xz \
    a3dc0872b1b39da34dc18ef1b944f0f11ffd37425d70ae04be679279f1cf43d2

(
    cd "$work/zlib-1.4"
    ./configure --static --prefix="$prefix"
    make -j"$(nproc)" libz.a
    install -Dm644 libz.a "$prefix/lib/libz.a"
    install -m644 zlib.h zconf.h "$prefix"
)

archive_source="$work/libarchive-3.8.11"
cmake -S "$archive_source" -B "$work/archive" \
    -DCMAKE_BUILD_TYPE=MinSizeRel -DBUILD_SHARED_LIBS=OFF \
    -DZLIB_INCLUDE_DIR="$prefix" -DZLIB_LIBRARY="$prefix/lib/libz.a" \
    -DENABLE_OPENSSL=OFF -DENABLE_MBEDTLS=OFF -DENABLE_NETTLE=OFF \
    -DENABLE_LIBB2=OFF -DENABLE_MD=OFF -DENABLE_BZip2=OFF -DENABLE_LIBXML2=OFF \
    -DENABLE_EXPAT=OFF -DENABLE_LZ4=OFF -DENABLE_LZMA=OFF -DENABLE_LZO=OFF \
    -DENABLE_ZSTD=OFF -DENABLE_ACL=OFF -DENABLE_PCREPOSIX=OFF -DENABLE_PCRE2POSIX=OFF \
    -DENABLE_CAT=OFF -DENABLE_CPIO=OFF -DENABLE_TAR=OFF -DENABLE_UNZIP=OFF -DENABLE_TEST=OFF
cmake --build "$work/archive" --target archive_static --parallel "$(nproc)"

make -C "$work/pkgr" static ARCHIVE_CFLAGS="-I$archive_source/libarchive -I$prefix" \
    ARCHIVE_LIBS="$work/archive/libarchive/libarchive.a $prefix/lib/libz.a"
