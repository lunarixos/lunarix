#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
ISO="${LUNARIX_ISO:-$ROOT/build/lunarix.iso}"
VM_DIR="${LUNARIX_VM_DIR:-${LUNARA_VM_DIR:-$ROOT/build/qemu}}"
DISK="$VM_DIR/lunarix.qcow2"
VARS="$VM_DIR/OVMF_VARS.fd"

usage() {
    cat <<'USAGE'
Usage: scripts/boot-iso [--installed] [--serial]

Boot the live ISO by default. Use --installed to boot the saved disk.
Set LUNARIX_ISO to select a different image or attach it read-only when
booting with --installed.
Live boots use temporary UEFI settings and retain the saved disk.
Use --serial for a terminal-only session, then select Lunarix Live (serial)
in GRUB when booting the ISO. Press Ctrl+A, then X to close serial QEMU.

LUNARIX_VM_DIR sets the directory for the guest disk and UEFI settings.
LUNARIX_VM_MEMORY sets the guest RAM, for example 2G (default 256M).
LUNARIX_VM_CPU selects a QEMU CPU model, for example max.
Set OVMF_CODE and OVMF_VARS together to use a custom firmware pair.
USAGE
}

installed=false
serial=false
for option in "$@"; do
    case "$option" in
        --installed) installed=true ;;
        --serial) serial=true ;;
        -h|--help) usage; exit 0 ;;
        *) echo "error: unknown option: $option" >&2; usage >&2; exit 2 ;;
    esac
done

if { ! "$installed" || [[ -n "${LUNARIX_ISO:-}" ]]; } && [[ ! -s "$ISO" ]]; then
    echo "error: no live ISO at $ISO. Run scripts/build-iso first." >&2
    exit 1
fi

for tool in qemu-system-x86_64 flock; do
    command -v "$tool" >/dev/null || { echo "error: $tool is required" >&2; exit 1; }
done

code="${OVMF_CODE:-}"
vars_template="${OVMF_VARS:-}"
if [[ -z "$code" && -z "$vars_template" ]]; then
    for directory in /usr/share/OVMF/x64 /usr/share/edk2/x64 /usr/share/edk2-ovmf/x64 \
                     /usr/share/OVMF /usr/share/edk2/ovmf /usr/share/edk2-ovmf; do
        for suffix in .4m _4M ''; do
            if [[ -s "$directory/OVMF_CODE$suffix.fd" && -s "$directory/OVMF_VARS$suffix.fd" ]]; then
                code="$directory/OVMF_CODE$suffix.fd"
                vars_template="$directory/OVMF_VARS$suffix.fd"
                break 2
            fi
        done
    done
fi
[[ -s "$code" && -r "$code" && -s "$vars_template" && -r "$vars_template" ]] || {
    echo 'error: install x86-64 OVMF firmware or set OVMF_CODE and OVMF_VARS to a matching pair.' >&2
    exit 1
}

mkdir -p -- "$VM_DIR"
exec 9>>"$VM_DIR/launch.lock"
flock -n 9 || { echo "error: a VM is already running in $VM_DIR" >&2; exit 1; }

if [[ ! -e "$DISK" && -f "$VM_DIR/lunara.qcow2" ]]; then
    DISK="$VM_DIR/lunara.qcow2"
fi
if "$installed" && [[ ! -s "$DISK" ]]; then
    echo "error: no QEMU disk at $DISK. Start with scripts/boot-iso and run lunarix-install in the guest." >&2
    exit 1
fi

temp_file=
trap 'if [[ -n "$temp_file" ]]; then rm -f -- "$temp_file"; fi' EXIT
if [[ ! -e "$DISK" ]]; then
    command -v qemu-img >/dev/null || { echo 'error: qemu-img is required to create the guest disk.' >&2; exit 1; }
    temp_file="$(mktemp "$VM_DIR/.disk.XXXXXX")"
    qemu-img create -q -f qcow2 "$temp_file" 2G
    mv -- "$temp_file" "$DISK"
    temp_file=
fi
if ! "$installed"; then
    temp_file="$(mktemp "$VM_DIR/.live-vars.XXXXXX")"
    cat -- "$vars_template" > "$temp_file"
    VARS="$temp_file"
elif [[ ! -e "$VARS" ]]; then
    temp_file="$(mktemp "$VM_DIR/.vars.XXXXXX")"
    cat -- "$vars_template" > "$temp_file"
    mv -- "$temp_file" "$VARS"
    temp_file=
fi

disk_device=virtio-blk-pci,drive=lunarix-disk
if "$installed"; then
    disk_device+=,bootindex=1
fi
args=(
    -machine q35
    -m "${LUNARIX_VM_MEMORY:-256M}"
    -smp 2
    -drive "if=pflash,format=raw,readonly=on,file=${code//,/,,}"
    -drive "if=pflash,format=raw,file=${VARS//,/,,}"
    -drive "if=none,id=lunarix-disk,format=qcow2,file=${DISK//,/,,}"
    -device "$disk_device"
    -netdev "user,id=net"
    -device "virtio-net-pci,netdev=net"
)
if [[ -n "${LUNARIX_VM_CPU:-}" ]]; then
    args+=(-cpu "$LUNARIX_VM_CPU")
fi
if "$installed"; then
    echo "==> Booting the installed disk: $DISK"
    if [[ -n "${LUNARIX_ISO:-}" ]]; then
        args+=(-drive "if=none,id=lunarix-media,format=raw,media=cdrom,readonly=on,file=${ISO//,/,,}"
               -device "ide-cd,drive=lunarix-media")
        echo "    Attached package media: $ISO"
    fi
else
    args+=(
        -drive "if=none,id=lunarix-live,format=raw,media=cdrom,readonly=on,file=${ISO//,/,,}"
        -device "ide-cd,drive=lunarix-live,bootindex=1"
    )
    echo "==> Booting the live ISO: $ISO"
    echo "    Attached virtual disk: $DISK"
    echo '    Inside the guest, run lunarix-install and select /dev/vda to install.'
    if "$serial"; then
        echo '    Select Lunarix Live (serial) in GRUB.'
    fi
fi
if "$serial"; then
    args+=(-nographic)
    echo '    Close QEMU with Ctrl+A, then X.'
fi
qemu-system-x86_64 "${args[@]}"
