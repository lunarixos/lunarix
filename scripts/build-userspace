#!/usr/bin/env bash
# Build and stage Lunarix's BusyBox userspace.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

BUILD_DIR="$PROJECT_ROOT/build"
SOURCE_DIR="$BUILD_DIR/busybox-src"
CONFIG="$PROJECT_ROOT/config/busybox.config"
REVISION_FILE="$PROJECT_ROOT/config/busybox.commit"
STAGING="$BUILD_DIR/userspace"

for cmd in git make install nproc; do
    command -v "$cmd" >/dev/null 2>&1 || {
        echo "error: required command '$cmd' not found." >&2
        exit 1
    }
done

REVISION="$(cat "$REVISION_FILE")"
[[ "$REVISION" =~ ^[0-9a-f]{40}$ ]] || {
    echo "error: invalid BusyBox commit in $REVISION_FILE" >&2
    exit 1
}

if [[ ! -e "$SOURCE_DIR" ]]; then
    mkdir -p "$BUILD_DIR"
    FETCH_DIR="$(mktemp -d "$BUILD_DIR/.busybox.XXXXXX")"
    trap 'rm -rf -- "$FETCH_DIR"' EXIT
    git -C "$FETCH_DIR" init -q
    git -C "$FETCH_DIR" fetch --depth=1 https://git.busybox.net/busybox "$REVISION"
    git -C "$FETCH_DIR" checkout -q --detach FETCH_HEAD
    mv -T -- "$FETCH_DIR" "$SOURCE_DIR"
fi

if [[ ! -d "$SOURCE_DIR/.git" ]] ||
    [[ "$(git -C "$SOURCE_DIR" rev-parse HEAD)" != "$REVISION" ]] ||
    [[ -n "$(git -C "$SOURCE_DIR" status --porcelain --untracked-files=no)" ]]; then
    echo "error: expected an unmodified BusyBox checkout at $REVISION in $SOURCE_DIR" >&2
    exit 1
fi

[[ -s "$CONFIG" ]] || {
    echo "error: BusyBox config missing: $CONFIG" >&2
    exit 1
}

echo "==> Configuring BusyBox"
cp "$CONFIG" "$SOURCE_DIR/.config"

make -C "$SOURCE_DIR" oldconfig </dev/null

echo "==> Compiling BusyBox"
make -C "$SOURCE_DIR" -j"$(nproc)"

echo "==> Installing BusyBox into staging"
rm -rf "$STAGING"
mkdir -p "$STAGING"

make -C "$SOURCE_DIR" CONFIG_PREFIX="$STAGING" install

echo
echo "==> Userspace build complete"
echo "    Staging: $STAGING"
